# HomeHub 실습 (학생판): git에 올리지 않는 것. 실습 명령(make)이 다시 만들거나, SETUP이 설치하거나,
# 학생에게 필요 없는 것입니다.

# 강사·개발용
# /docs/INSTRUCTOR_NOTES.md
# /docs/고칠것.md
__tmp__/

# 실습 산출물. 아래 폴더는 저장소에 들어 있어서 막지 않습니다: 실습이 잘 안될 때 모범 답안으로 이어 가는 데 씁니다.
#   build/, legacy/build/  JDK 11(SETUP이 설치하는 버전)로 만든 바이너리. 학생 PC에서 다시 빌드해도 같습니다
#   out/                   Codex에게 받아 둔 답(out/codex/), 노트북에 저장된 결과가 여는 보고서(out/html/_nb/)
#   work/                  모범 답안 패치를 적용하고 빌드해 둔 프로젝트
#   mine/                  B-1의 예시 답(Codex가 만든 Dafny 모델과 연결 코드)
#   notebooks/out/         노트북 보고서
# /build/
# /legacy/build/
# /out/
# /work/
# /notebooks/out/
# /mine/*
# !/mine/README.txt
# 자습 가이드 0-0에서 만드는 시작 상태 백업
/_backup/
# lab.patch가 남기는 원본 (lab.restore가 되돌림)
*.orig

# Python
__pycache__/
*.pyc
/.venv/
.ipynb_checkpoints/

# SETUP(setup.py → setup_mac.sh / setup_windows.bat)이 설치하는 것과 내려받은 파일
/jdk/
/dafny/
/python/
/_unpack_tmp/
/SETUP/*.zip
/SETUP/*.tar.gz
/SETUP/*.pkg
/SETUP/_python_choices.xml

# OS
.DS_Store
Thumbs.db
